[Unit]
Description=HU Cluster Container (Infotainment Domain)
# Docker daemon must be up first.
# vsomeip routing manager for IPC.
# unified-compositor.service creates the wayland-2 socket HU apps connect to.
After=docker.service vsomeip-routing-manager.service unified-compositor.service
Requires=docker.service vsomeip-routing-manager.service
Wants=unified-compositor.service

# Prevent native HU app services from running alongside the container.
# Do NOT conflict with unified-compositor.service — it must run on the host (Option B2).
Conflicts=gearapp.service mediaapp.service ambientapp.service homescreenapp.service

[Service]
Type=simple
User=root

# Step 1: Build the image on first boot if it does not exist yet
ExecStartPre=/bin/sh -c '/usr/bin/build-hu-container.sh'

# Step 2: Wait for wayland-2 socket — created by host UnifiedCompositor (Option B2)
ExecStartPre=/bin/sh -c \
    'for i in $(seq 1 30); do \
         test -S /run/user/1000/wayland-2 && exit 0; \
         sleep 1; \
     done; \
     echo "wayland-2 socket not found (is unified-compositor running?)"; exit 1'

# Step 3: Clean up any leftover container from a previous run
ExecStartPre=-/usr/bin/docker rm -f hu-cluster

# ── docker run cgroup flags ────────────────────────────────────────────────
# --cpus      → limits HU to 40% of total CPU across all cores (cpu.max cgroup)
# --memory    → hard 2 GB memory limit (memory.max cgroup)
# --memory-swap → set equal to memory to disable swap for this container
#
# No GPU devices needed: HU apps are plain Wayland clients using wl_shm.
# UnifiedCompositor on the host does the actual GPU rendering.
#
# Volume mounts:
#   /run/user/1000  → wayland-2 socket (UnifiedCompositor) + vsomeip sockets
#   /tmp            → vsomeip Unix domain sockets under /tmp/vsomeip-*
#   /usr/lib        → Qt5, vsomeip, boost, commonapi shared libs
#   /usr/lib/plugins → Qt5 platform plugins (wayland, etc.)
#   /usr/lib/qml    → Qt5 QML import modules
#   /usr/share/fonts → fonts for Qt text rendering
#   /etc/fonts      → fontconfig configuration
#   /usr/share/X11  → xkb keyboard layout data (xkbcommon)
ExecStart=/usr/bin/docker run \
    --name hu-cluster \
    --rm \
    --network=host \
    --user=1000:1000 \
    --cpuset-cpus=2,3,4,5 \
    --cpus=0.4 \
    --memory=2g \
    --memory-swap=2g \
    -v /run/user/1000:/run/user/1000 \
    -v /tmp:/tmp \
    -v /usr/lib:/usr/lib:ro \
    -v /usr/lib/plugins:/usr/lib/plugins:ro \
    -v /usr/lib/qml:/usr/lib/qml:ro \
    -v /usr/share/fonts:/usr/share/fonts:ro \
    -v /etc/fonts:/etc/fonts:ro \
    -v /usr/share/X11:/usr/share/X11:ro \
    -e WAYLAND_DISPLAY=wayland-2 \
    -e XDG_RUNTIME_DIR=/run/user/1000 \
    -e QT_QPA_PLATFORM=wayland \
    -e QT_WAYLAND_DISABLE_WINDOWDECORATION=1 \
    -e QSG_RENDER_LOOP=basic \
    -e QT_QUICK_BACKEND=software \
    -e QT_WAYLAND_HARDWARE_INTEGRATION=none \
    -e QT_QPA_FONTDIR=/usr/share/fonts/truetype \
    -e FONTCONFIG_FILE=/etc/fonts/fonts.conf \
    -e LD_LIBRARY_PATH=/usr/lib \
    -e QT_PLUGIN_PATH=/usr/lib/plugins \
    -e QML2_IMPORT_PATH=/usr/lib/qml \
    hu-cluster:latest

ExecStop=/usr/bin/docker stop hu-cluster

Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
