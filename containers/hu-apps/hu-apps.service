[Unit]
Description=HU Apps (GearApp, HomeScreen, Media, Ambient) via Docker Compose
Documentation=https://github.com/leo9044/PDC_Yocto_Jetson-orin-nano
Requires=docker.service unified-compositor.service vsomeip-routing-manager.service
After=docker.service unified-compositor.service vsomeip-routing-manager.service

[Service]
Type=simple
User=root
WorkingDirectory=/etc/hu-apps

# wayland-2 소켓 대기
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do test -S /run/user/1000/wayland-2 && break || sleep 1; done'

ExecStart=/usr/bin/docker-compose -f /etc/hu-apps/docker-compose.yml up
ExecStop=/usr/bin/docker-compose -f /etc/hu-apps/docker-compose.yml down
ExecReload=/usr/bin/docker-compose -f /etc/hu-apps/docker-compose.yml restart

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
